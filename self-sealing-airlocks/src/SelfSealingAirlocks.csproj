<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-sealing Airlocks (Continued) - an Oxygen Not Included mod, GPL-3.0 (see ../LICENSE).
    Our continuation of yohan-id's SelfSealingAirlocksRevivedV2 (commit dce21ce, 2026-10-31).
    Builds on Linux with the .NET 8 SDK, the same way as ../../honest-instant-build: the
    reference-assemblies package supplies the .NET Framework 4.8 surface, and the game's own
    DLLs come from the sibling mod's lib/ (copied from the game, see the top README; never
    committed). Always compile against the CURRENT game DLLs - compiling against an old copy is
    what caused the U57+ "Method not found: SimMessages.SetCellProperties" crash.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>SelfSealingAirlocks</AssemblyName>
    <RootNamespace>SelfSealingAirlocks</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GameLib>$(MSBuildProjectDirectory)/../../honest-instant-build/lib</GameLib>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameLib)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameLib)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameLib)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameLib)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameLib)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="mod_info.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
