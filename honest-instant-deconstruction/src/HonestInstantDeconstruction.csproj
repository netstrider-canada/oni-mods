<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Honest Instant Deconstruction - an Oxygen Not Included mod.
    Builds on Linux with the .NET 8 SDK: the reference-assemblies package supplies the
    .NET Framework 4.8 surface (the shipped 0Harmony.dll targets 4.8) the game's Mono runtime expects, and the game's own DLLs
    come from the sibling mod's ../../honest-instant-build/lib (copied from the game, see the top README; never committed).
    Only HonestInstantDeconstruction.dll ships; Private=false keeps the game DLLs out of bin/.
  -->

  <PropertyGroup>
    <!-- Same source, same bytes: the release gate records each DLL's SHA-1 and the installer
         refuses any other, so the build must not stamp the git commit in (a docs commit after
         the gate changed the DLL, 2026-11-12). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>HonestInstantDeconstruction</AssemblyName>
    <RootNamespace>HonestInstantDeconstruction</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GameLib>$(MSBuildProjectDirectory)/../../honest-instant-build/lib</GameLib>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameLib)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameLib)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameLib)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameLib)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameLib)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="mod_info.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
